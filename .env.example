# URL Laravel Admin Panel (misal: http://127.0.0.1:8000 atau domain ngrok/production)
API_URL=http://127.0.0.1:8000

# ID situs di Admin Panel
SITE_ID=03-shiftmate

# Kunci rahasia dari tab 'Kunci Akses' di Admin Panel
SITE_SECRET=your_site_secret_here

# Waktu cache / ISR dalam detik (opsional, default 120 detik)
REVALIDATE_SECONDS=120
